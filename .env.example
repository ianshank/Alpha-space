# ZeroG-RL Environment Variables
# Copy this file to .env and fill in your values.

# Weights & Biases (optional)
WANDB_API_KEY=
WANDB_PROJECT=zerog-rl
WANDB_ENTITY=

# GCP (optional, for distributed training)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Training overrides (all optional — see src/config.py for full list)
# ZEROG_LEARNING_RATE=0.0001
# ZEROG_BATCH_SIZE=256
# ZEROG_NUM_EPISODES=1000
# ZEROG_SIMULATOR=mock
# ZEROG_VOXEL_RESOLUTION=64
# ZEROG_MCTS_SIMULATIONS=800
# ZEROG_SEED=42
# ZEROG_PARALLEL_ENVS=1
